# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
# NO trailing slash, deliberately (2026-07-27). A trailing-slash pattern matches
# only real directories, never a symlink to one — and some worktrees carry .venv
# as a symlink back to the main tree's real venv, which then showed as untracked
# forever. Verified with `git check-ignore -v .venv`: exit 1 under `.venv/`,
# exit 0 under `.venv`.
.venv
venv/
*.so
# OS
.DS_Store

# IDE
.vs/
.idea/
*.suo
*.user
*.userprefs

# Obsidian (commit config, ignore workspace cache)
documentation/.obsidian/workspace.json
documentation/.obsidian/workspace-mobile.json
documentation/.obsidian/plugins/
documentation/.obsidian/themes/
documentation/.obsidian/hotkeys.json

# AI tool config
.gemini/

# Secrets (envchain loads from macOS Keychain — .env is only for local overrides)
.env
config.local.json
config.local.json.bak*

# direnv
.direnv/

# SQLite dev database
dev.db

# Claude Code workflow flags (transient, per-session)
.claude/no_jira_required
.claude/scheduled_tasks.lock
.claude/.rc-pair-state.json

# Test artifacts
test.db
.coverage
htmlcov/

# Exported conversation transcripts (generated output)
docs/conversations/*
!docs/conversations/README.md

# Scratch / working notes
SCRATCH.md

# Claude Code workflow (transient, per-session)
.claude/signals/
.claude/state/
.claude/handoff-queue/claimed/
.claude/handoff-queue/completed/
.worktrees/

# Playwright MCP
.playwright-mcp/

# Python lock file (regenerated by uv)
uv.lock
scratchpad-run6.log
tier1_classifier.npz
*.npz

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/
.beads/.displayid-sweep-heartbeat.json

# Repo-root gate/lock markers (e.g. .beads.gate.lock): machine-local coordination
# state, never repo content. Caught one already committed+pushed by sync-git's
# byte-safe-by-default commit path (mirrors the fix in a sibling tool).
/.*.lock
*.receipt.jsonl.lock
*.receipt.jsonl.run.lock
